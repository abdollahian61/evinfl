# Copy to private/secrets.yml, chmod 600, replace values.
# Supply with ansible-playbook -e @private/secrets.yml (or encrypt with Vault).
minio_root_user: backup-admin
minio_root_password: CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
minio_license_src: /absolute/path/to/minio.license
zabbix_db_password: CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
grafana_admin_password: CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
clickhouse_app_password: CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
meilisearch_master_key: CHANGE_ME_USE_AT_LEAST_32_RANDOM_CHARACTERS
# Needed only when enabling automatic NFS backup.
nfs_backup_access_key: CHANGE_ME
nfs_backup_secret_key: CHANGE_ME
nfs_backup_repository_password: CHANGE_ME_KEEP_AN_OFFLINE_COPY
