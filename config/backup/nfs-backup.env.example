# Install outside the repository as /etc/nfs-backup.env, root:root, mode 600.
# These paths assume the separate NFS data disk is mounted at /srv/nfs.
BACKUP_SOURCE='/srv/nfs'
DATA_MOUNT='/srv/nfs'
BACKUP_HOST='nfs01'

# Private S3 endpoint; update if TLS or a different port is configured in MinIO.
RESTIC_REPOSITORY='s3:http://192.168.1.28:9000/nfs-backup'
AWS_ACCESS_KEY_ID='CHANGE_ME'
AWS_SECRET_ACCESS_KEY='CHANGE_ME'
AWS_DEFAULT_REGION='us-east-1'
RESTIC_PASSWORD_FILE='/etc/nfs-backup.password'
