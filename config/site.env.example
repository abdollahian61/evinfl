# Copy to private/site.env on monitoring01 and edit; do not put secrets here.
# The SSH user must already exist on target Ubuntu VMs and have working sudo.
SSH_USER=devops
SSH_KEY="$HOME/.ssh/id_ed25519"
MASTER_IP=192.168.1.10
NFS_IP=192.168.1.24
MINIO_ENDPOINT=http://192.168.1.28:9000
APP_DOMAIN=app.example.com
KUBESPRAY_DIR="$HOME/evinfl-tools/kubespray"
VENV_DIR="$HOME/evinfl-tools/ansible-venv"
